{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "labels": {
      "name": "myapp"
    },
    "name": "myapp",
    "namespace": "default"
  },
  "spec": {
    "containers": [
      {
        "image": "nginx",
        "name": "myapp",
        "ports": [
          {
            "containerPort": 1234
          }
        ]
      }
    ]
  }
}
